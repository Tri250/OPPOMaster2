# =============================================================================
# Release 签名配置 - 模板文件
# =============================================================================
# 使用说明：
# 1. 复制此文件为 keystore-release.properties（在 app/ 目录下）
# 2. 填入真实的密钥库信息
# 3. 不要将 keystore-release.properties 提交到版本控制（已在 .gitignore 中排除）
#
# 密钥库生成命令：
#   ./scripts/generate-keystore.sh
# =============================================================================

# 密钥库文件路径（相对于 app/ 目录）
# 建议使用绝对路径以避免工作目录问题
storeFile=release.keystore

# 密钥库密码
storePassword=YOUR_STORE_PASSWORD_HERE

# 密钥别名
keyAlias=omaster

# 密钥密码
keyPassword=YOUR_KEY_PASSWORD_HERE
