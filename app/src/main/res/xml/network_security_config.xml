<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认仅允许 HTTPS，禁用明文流量 -->
    <base-config cleartextTrafficPermitted="false">
        <!-- TLS 1.2 及以上版本 -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 生产环境域名白名单（仅 HTTPS） -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">jsdelivr.net</domain>
        <domain includeSubdomains="true">unsplash.com</domain>
        <domain includeSubdomains="true">gitee.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">umeng.com</domain>
    </domain-config>

    <!-- API 域名证书固定（防止中间人攻击） -->
    <!-- 注意：证书过期前需更新 pin，建议同时 pin 根证书和备用证书 -->
    <domain-config>
        <domain includeSubdomains="true">omaster.app</domain>
        <domain includeSubdomains="true">omaster.ai</domain>
        <pin-set expiration="2027-12-31">
            <!-- Let's Encrypt ISRG Root X1 (RSA) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- Let's Encrypt ISRG Root X2 (ECDSA) -->
            <pin digest="SHA-256">diGVwiVtH1rF8EywzM4S2/xv5c7HMDv7g5qBl5RFw5Q=</pin>
            <!-- Google Trust Services GTS Root R1 备用 -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
        </pin-set>
        <!-- 信任用户安装的证书（兼容代理/VPN环境） -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- Debug 模式信任用户证书（仅在 debug build 中生效） -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>