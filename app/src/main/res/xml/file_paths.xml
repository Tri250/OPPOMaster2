<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 应用私有外部文件目录 - 仅用于 APK 更新下载 -->
    <external-files-path
        name="downloads"
        path="Download/" />

    <!-- 应用私有缓存目录 - 用于相机拍照临时文件共享 -->
    <cache-path
        name="camera_cache"
        path="camera/" />

    <!-- 应用私有缓存目录 - 用于分享临时文件 -->
    <cache-path
        name="share_cache"
        path="share/" />

    <!-- 应用私有外部图片目录 - 用于哈苏之眼拍照临时文件 -->
    <external-files-path
        name="hasselblad_pictures"
        path="Pictures/" />
</paths>
