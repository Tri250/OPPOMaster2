<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+
   控制云备份和设备传输时的数据范围
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <!-- 排除敏感数据 -->
        <!-- 自检修正：实际文件名为 omaster_subscriptions.xml（复数，见 SubscriptionManager.kt） -->
        <exclude domain="sharedpref" path="omaster_subscriptions.xml" tools:ignore="FullBackupContent" />
        <!-- 排除缓存 -->
        <exclude domain="file" path="cache/" tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <!-- 设备传输时包含用户偏好但排除凭证 -->
        <!-- 自检修正：实际 legacy 设置 prefs 文件名为 app_settings.xml（见 SettingsManager.kt） -->
        <include domain="sharedpref" path="app_settings.xml" />
        <exclude domain="sharedpref" path="omaster_subscriptions.xml" tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
