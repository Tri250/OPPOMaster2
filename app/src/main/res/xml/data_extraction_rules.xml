<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+：云备份与设备迁移，ColorOS 互传/换机克隆场景)。
   【v1.6.13 隐私加固】排除运行期诊断文件（日志与崩溃堆栈），
   与 backup_rules.xml（API < 31）保持一致，防止诊断数据随云备份/换机迁移外流。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs" />
        <exclude domain="external" path="crash.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs" />
        <exclude domain="external" path="crash.log" />
    </device-transfer>
</data-extraction-rules>
