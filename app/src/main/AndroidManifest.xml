<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- MU-25 / v1.6.6：移除 android.permission.DOWNLOAD_WITHOUT_NOTIFICATION。
         更新下载使用 DownloadManager + VISIBILITY_VISIBLE_NOTIFY_COMPLETED（显式展示通知），
         该权限仅在需要"静默下载（不显示通知）"时才必要，此处属多余声明，移除以减少安装期权限面。 -->

    <!--
        ED-08：悬浮窗需在相机等第三方前台应用之上持续显示，必须作为前台服务运行，
        否则 Android 8.0(API 26) 起从后台（侧边键快捷方式广播）启动会抛
        IllegalStateException: Not allowed to start service ... app is in background。
        Android 14(API 34) 起还需声明类型专属权限 FOREGROUND_SERVICE_SPECIAL_USE。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 声明QQ包可见性，用于检测QQ是否安装 -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.tim" />
    </queries>

    <application
        android:name=".OMasterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OMaster">

        <!--
            ED-08 / MU-25：Android 17 API 37 合规
            foregroundServiceType="specialUse" — 悬浮窗 Service 用途为"显示在其他应用上层的特殊辅助"，
            匹配 Android 17 ForegroundService 类型要求（targetSdk 36 下声明不影响运行时行为，但保证未来升级无隐患）。
            stopWithTask="false" — 用户手动杀掉相机任务时悬浮窗不被连带销毁（跨任务持续）。
            exported="false" — 非系统绑定，内部 startService/stopService。
         -->
        <service
            android:name=".ui.service.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <!--
                ED-08：Android 14(API 34) 起，foregroundServiceType="specialUse" 必须在 manifest
                声明用途 property，否则 startForeground 抛 MissingForegroundServiceTypeException。
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_camera_preset_overlay" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- FD-01c：接收系统分享的预设 JSON 文本（微信 / QQ / 浏览器分享到 OMaster） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
                FD-06 / ColorOS 17 AI 一键闪记：
                接收 ColorOS 17 AI 闪记（侧边键长按）截图的系统分享图片。
                用户在相机参数页触发 AI 闪记 → 系统生成 OCR 文本 + 原图 →
                分享到 OMaster 时走 ACTION_SEND_IMAGE → 由 MainActivity 分发给
                ImportPipeline.Source.OCR_IMAGE 入口（ScreenCaptureParser.parse + OCR fallback）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 下载完成广播接收器 -->
        <receiver
            android:name=".util.DownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- MU-24 / v1.6：ColorOS 17 侧边键快捷键支持 -->
        <!-- shortcut meta-data（静态 shortcut 资源） -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <!-- MU-24：悬浮窗快捷方式广播接收器（ACTION_SHOW_FLOATING_WINDOW） -->
        <!-- 当用户在 ColorOS 17 设置把侧边键映射到 OMaster 悬浮窗 shortcut 时， -->
        <!-- 系统发送此 action，广播接收器转发给 FloatingWindowService 显示悬浮窗 -->
        <receiver
            android:name=".ui.service.ShortcutBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.silas.omaster.action.ACTION_SHOW_FLOATING_WINDOW" />
            </intent-filter>
        </receiver>

        <!-- MU-28 / v1.6：AndroidX Glance 桌面小组件 -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
    
    </application>

</manifest>
