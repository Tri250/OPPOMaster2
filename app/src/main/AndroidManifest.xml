<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ 包可见性声明 -->
    <!-- 声明需要查询的应用列表，避免 PackageManager 查询返回空 -->
    <queries>
        <!-- 浏览器（用于打开外部链接、隐私政策等） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- 图片查看器（用于分享/打开图片） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- 相机应用（备用相机入口） -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- 分享功能 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- 应用商店（用于评分/更新引导） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <!-- 网络相关权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 设备信息权限（友盟统计设备标识，仅 Android 9 及以下使用，Android 10+ 已由 OAID 替代） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="28" />

    <!-- 悬浮窗权限（用于悬浮窗功能） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 应用安装权限（应用内更新功能，检查更新后安装 APK 所需） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 通知权限（Android 13+ 必需） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 外部存储写入权限（Android 10+ 作用域存储） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ 图片读取权限（替代 READ_EXTERNAL_STORAGE） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ 部分图片访问权限（与 READ_MEDIA_IMAGES 配合使用） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- 前台服务权限 (Android 14+ 必需) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 相机权限（SceneRecognitionManager / SmartOptimize 使用） -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 录制音频权限（CameraX 视频录制模式及语音快门所需） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 定位权限（地标识别 / GPS 场景增强） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 传感器权限（陀螺仪、加速度计用于防抖/水平仪/AR构图） -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- 唤醒锁（前台渲染防休眠，长曝光/光绘模式保持屏幕常亮） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OMasterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OMaster"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        tools:targetApi="36">

        <!-- App Shortcuts (Android 7.1+) - 提供相机快捷入口 -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <service
            android:name=".ui.service.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
              Android 14+ 要求 specialUse 类型前台服务必须声明用途属性
              用途：实时显示相机预设参数悬浮窗，便于用户在不离开相机界面的情况下
                    切换和查看不同预设效果，是核心功能（相机调参助手）的必要组成部分。
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="camera_preset_overlay" />
        </service>

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".push.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="omaster_news" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link: omaster://preset/{id} 和 https://omaster.app/preset/{id} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- 自定义 scheme -->
                <data android:scheme="omaster" android:host="preset" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- HTTPS 链接（需配置 assetlinks.json） -->
                <data
                    android:scheme="https"
                    android:host="omaster.app"
                    android:pathPrefix="/preset" />
            </intent-filter>
        </activity>

        <provider
            android:name=".InitializationProvider"
            android:authorities="${applicationId}.initialization"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>