<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络相关权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 敏感权限说明：READ_PHONE_STATE
         用途：用于友盟统计分析获取设备标识，仅在 Android 9 及以下使用。
         使用场景：应用启动统计与崩溃上报。
         该权限已在运行时向用户申请。 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="28" />

    <!-- 敏感权限说明：SYSTEM_ALERT_WINDOW
         用途：用于悬浮窗快捷工具功能，允许用户在其它应用上层显示参数调节悬浮窗。
         使用场景：用户在拍摄或修图过程中快速调整 LUT/参数。
         该权限需要用户在系统设置中手动授权。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 敏感权限说明：REQUEST_INSTALL_PACKAGES
         用途：用于应用内更新，下载新版本 APK 后请求安装。
         使用场景：用户主动点击“检查更新”并确认下载后发起安装。
         该权限仅在用户触发更新流程时使用。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 通知权限（Android 13+ 必需） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 外部存储写入权限（Android 10+ 作用域存储） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 敏感权限说明：READ_MEDIA_IMAGES
         用途：用于读取相册图片以进行 LUT 预览、编辑与导出，替代 Android 13 之前的 READ_EXTERNAL_STORAGE。
         使用场景：用户从相册选择图片进行编辑或导入 LUT 预览。
         该权限在 Android 13+ 运行时向用户申请。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 敏感权限说明：FOREGROUND_SERVICE_SPECIAL_USE
         用途：用于在后台保持特殊用途前台服务，支撑悬浮窗参数调节与图片处理任务的稳定性。
         使用场景：用户开启悬浮窗或执行批量导出任务时保持服务运行。
         该权限声明与对应前台服务类型 specialUse 一致。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 相机硬件特性声明：应用使用相机但非必需，未安装相机的设备仍可安装 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- 相机权限（SceneRecognitionManager / SmartOptimize 使用） -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 唤醒锁（前台 Service 跑渲染时防止休眠） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OMasterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OMaster"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <service
            android:name=".ui.service.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:theme="@style/Theme.OMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".InitializationProvider"
            android:authorities="${applicationId}.initialization"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 下载完成广播接收器 -->
        <receiver
            android:name=".util.DownloadCompleteReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
