            "range": [0.0, 1.0],
            "mappedRange": [-100, 100],
            "mappedUnit": "",
            "formula": "(value - 0.5) * 200.0"
          },
          {
            "id": 10,
            "name": "tint",
            "displayName": "色调",
            "range": [0.0, 1.0],
            "mappedRange": [-100, 100],
            "mappedUnit": "",
            "formula": "(value - 0.5) * 200.0"
          },
          {
            "id": 11,
            "name": "sharpness",
            "displayName": "锐化",
            "range": [0.0, 1.0],
            "mappedRange": [0, 100],
            "mappedUnit": "",
            "formula": "value * 100.0"
          },
          {
            "id": 12,
            "name": "noise_reduction",
            "displayName": "降噪",
            "range": [0.0, 1.0],
            "mappedRange": [0, 100],
            "mappedUnit": "",
