      "version": "1.2.0",
      "status": "not_ready",
      "architecture": {
        "type": "MLP",
        "framework": "TensorFlow 2.14",
        "layers": [
          {"type": "input", "size": 40},
          {"type": "dense", "size": 128, "activation": "relu"},
          {"type": "dropout", "rate": 0.2},
          {"type": "dense", "size": 64, "activation": "relu"},
          {"type": "dropout", "rate": 0.2},
          {"type": "dense", "size": 32, "activation": "relu"},
          {"type": "dense", "size": 18, "activation": "sigmoid"}
        ],
        "parameters": 12690,
        "flops": 25380
      },
      "input": {
        "name": "input",
        "dataType": "FLOAT32",
        "shape": [1, 40],
        "format": "feature_vector",
        "components": [
          {
            "name": "scene_features",
            "startIndex": 0,
            "endIndex": 35,
            "size": 36,
            "source": "scene_classifier.output",
            "description": "36维场景概率向量"
          },
          {
            "name": "quality_features",
            "startIndex": 36,
            "endIndex": 39,
            "size": 4,
            "source": "quality_analyzer.output",
            "description": "4维质量评分向量"
          }
