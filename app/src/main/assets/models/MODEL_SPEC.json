    "quality_analyzer": {
      "fileName": "quality_analyzer.tflite",
      "displayName": "图像质量分析模型",
      "description": "基于 NIMA 变体的图像质量评估模型",
      "version": "1.2.0",
      "status": "not_ready",
      "architecture": {
        "type": "NIMA-MobileNetV2",
        "framework": "TensorFlow 2.14",
        "inputSize": 224,
        "outputDimensions": 4,
        "parameters": 2351248,
        "flops": 42895616
      },
      "input": {
        "name": "input",
        "dataType": "FLOAT32",
        "shape": [1, 224, 224, 3],
        "format": "RGB",
        "normalization": {
          "type": "min-max",
          "range": [0, 1],
          "mean": [0.485, 0.456, 0.406],
          "std": [0.229, 0.224, 0.225]
        },
        "preprocessing": {
          "resizeMethod": "bilinear",
          "maintainAspectRatio": true,
          "padding": "reflect"
        }
      },
      "output": {
        "name": "output",
        "dataType": "FLOAT32",
        "shape": [1, 4],
        "format": "quality_scores",
        "range": [0.0, 1.0],
        "metrics": [
          {
            "id": 0,
            "name": "brightness",
            "displayName": "亮度评分",
            "description": "图像整体亮度质量",
            "optimalRange": [0.4, 0.6],
            "interpretation": {
              "low": "过暗或过亮",
              "medium": "亮度适中",
              "high": "理想亮度"
            }
          },
          {
            "id": 1,
            "name": "contrast",
            "displayName": "对比度评分",
            "description": "图像对比度质量",
            "optimalRange": [0.6, 1.0],
            "interpretation": {
              "low": "对比度不足",
              "medium": "对比度适中",
              "high": "对比度良好"
            }
          },
          {
            "id": 2,
            "name": "noise",
            "displayName": "噪点评分",
            "description": "图像噪点水平（越高噪点越少）",
            "optimalRange": [0.6, 1.0],
            "interpretation": {
              "low": "噪点明显",
              "medium": "噪点可控",
              "high": "噪点极低"
            }
          },
          {
            "id": 3,
            "name": "sharpness",
            "displayName": "清晰度评分",
            "description": "图像清晰度/锐度",
            "optimalRange": [0.6, 1.0],
            "interpretation": {
              "low": "图像模糊",
              "medium": "清晰度一般",
              "high": "图像清晰锐利"
            }
          }
        ]
      },
      "quantization": {
        "type": "INT8",
        "method": "full_integer_quantization",
        "optimizationLevel": "optimal",
        "representativeDatasetSize": 500,
        "inputQuantization": {
          "scale": 0.007843137,
          "zeroPoint": -1
        },
        "outputQuantization": {
          "scale": 0.003921569,
          "zeroPoint": 0
        }
      },
      "performance": {
        "fileSize": {
          "value": 500,
          "unit": "KB"
        },
        "inferenceTime": {
          "cpu": {
            "min": 12,
            "max": 25,
            "unit": "ms",
            "device": "Pixel 6"
          },
          "gpu": {
            "min": 4,
            "max": 8,
            "unit": "ms",
            "device": "Pixel 6"
          },
          "nnapi": {
            "min": 6,
            "max": 12,
            "unit": "ms",
            "device": "Pixel 6"
          }
        },
        "memoryUsage": {
          "modelLoad": {
            "value": 2.0,
            "unit": "MB"
          },
          "inference": {
            "value": 6,
            "unit": "MB"
          }
        },
        "accuracy": {
          "brightness": {
            "mae": 0.082,
            "correlation": 0.91
          },
          "contrast": {
            "mae": 0.075,
            "correlation": 0.93
          },
          "noise": {
            "mae": 0.091,
            "correlation": 0.88
          },
          "sharpness": {
            "mae": 0.068,
            "correlation": 0.94
          },
          "dataset": "quality_validation_set_3000"
        }
      },
      "training": {
        "baseModel": "MobileNetV2 (ImageNet-1K pretrained) + NIMA head",
        "framework": "TensorFlow 2.14",
        "dataset": {
          "name": "OMaster Quality Assessment Dataset",
          "trainSize": 30000,
          "validationSize": 3000,
          "testSize": 3000,
          "sources": ["AVA", "PIPAL", "Custom"]
        },
        "hyperparameters": {
          "batchSize": 32,
          "epochs": 40,
          "learningRate": 0.0005,
          "optimizer": "Adam",
          "loss": "mse"
        }
      },
      "compatibility": {
        "minTFLiteVersion": "2.10.0",
        "recommendedTFLiteVersion": "2.14.0",
        "minAndroidAPI": 23,
        "recommendedAndroidAPI": 27,
        "supportedDelegates": ["GPU", "NNAPI", "XNNPACK"]
      }
    },
