          "trainSize": 100000,
          "validationSize": 10000,
          "testSize": 10000,
          "annotationMethod": "expert_tuning"
        },
        "hyperparameters": {
          "batchSize": 64,
          "epochs": 100,
          "learningRate": 0.001,
          "optimizer": "Adam",
          "loss": "mse",
