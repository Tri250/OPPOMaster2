      "output": {
        "name": "output",
        "dataType": "FLOAT32",
        "shape": [1, 18],
        "format": "normalized_parameters",
        "range": [0.0, 1.0],
        "parameters": [
          {
            "id": 0,
            "name": "exposure",
            "displayName": "曝光补偿",
            "range": [0.0, 1.0],
            "mappedRange": [-2.0, 2.0],
            "mappedUnit": "EV",
            "formula": "(value - 0.5) * 4.0"
          },
          {
            "id": 1,
            "name": "contrast",
            "displayName": "对比度",
            "range": [0.0, 1.0],
            "mappedRange": [-100, 100],
            "mappedUnit": "",
            "formula": "(value - 0.5) * 200.0"
          },
          {
            "id": 2,
            "name": "saturation",
            "displayName": "饱和度",
            "range": [0.0, 1.0],
            "mappedRange": [-100, 100],
            "mappedUnit": "",
            "formula": "(value - 0.5) * 200.0"
          },
          {
            "id": 3,
            "name": "highlights",
            "displayName": "高光调整",
            "range": [0.0, 1.0],
            "mappedRange": [-100, 100],
            "mappedUnit": "",
            "formula": "(value - 0.5) * 200.0"
          },
          {
            "id": 4,
